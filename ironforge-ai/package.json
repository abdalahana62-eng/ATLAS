{
  "name": "ironforge-ai",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js",
    "build:mobile": "node scripts/build.js",
    "cap:init": "cap init IronForge AI com.ironforge.ai --web-dir=out",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android",
    "cap:build:apk": "cap sync android && cd android && gradlew assembleRelease",
    "ads:setup": "node scripts/setup-admob.js",
    "start": "next start",
    "lint": "next lint",
    "audit:security": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.424.0",
    "next": "^14.2.35",
    "next-intl": "^3.26.3",
    "openai": "^4.55.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.2.0",
    "@types/react": "^18.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4"
  }
}
