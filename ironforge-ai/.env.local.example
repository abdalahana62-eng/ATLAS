# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only: NEVER prefix with NEXT_PUBLIC_. Required for admin + server routes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq (OpenAI-compatible) Configuration — نفس المفتاح يشغّل أقوى موديل
OPENAI_API_KEY=your-groq-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# ---- Admin panel (REQUIRED for /admin login) ----
# Triple lock: ADMIN_EMAIL + ADMIN_PASSWORD + Google session of the same email.
# Set BOTH in Vercel → Settings → Environment Variables AND locally in .env.local.
ADMIN_EMAIL=abdalahana555@gmail.com
# Strong random password, e.g. `openssl rand -base64 32`. Min 16 chars.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# ---- Email (optional, only for /api/admin/send-email) ----
RESEND_API_KEY=
RESEND_FROM=ATLAS <noreply@atlasfit.pro>

# ---- CORS allow-list (comma-separated). The APK + localhost are built-in. ----
# Example: ALLOWED_ORIGINS=https://atlasfit.pro,https://www.atlasfit.pro
ALLOWED_ORIGINS=
# APP_URL=https://your-app.vercel.app
