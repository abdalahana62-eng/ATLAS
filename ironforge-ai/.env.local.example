# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only: NEVER prefix with NEXT_PUBLIC_. Required for admin + server routes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq (OpenAI-compatible) Configuration — نفس المفتاح يشغّل أقوى موديل
OPENAI_API_KEY=your-groq-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# ---- Admin panel (REQUIRED for /admin login) ----
# Triple lock: ADMIN_EMAIL + ADMIN_PASSWORD + Google session of the same email.
# Set BOTH in Vercel → Settings → Environment Variables AND locally in .env.local.
# NEVER commit real values. Generate password with: openssl rand -base64 32
ADMIN_EMAIL=owner@example.com
# Strong random password, e.g. `openssl rand -base64 32`. Min 16 chars.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# ---- Payments (server-only) ----
# Displayed only to users via /api/public-config (rate-limited), never bundled.
PAY_NUMBER=

# ---- Rate-limit (optional, recommended for Vercel multi-instance) ----
# Upstash Redis REST (distributed). Without it, limiter is per-instance best-effort.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Updates / repo (optional) ----
GITHUB_REPO=
GITHUB_TOKEN=

# ---- Email (optional, only for /api/admin/send-email) ----
RESEND_API_KEY=
RESEND_FROM=ATLAS <noreply@atlasfit.pro>

# ---- SEO / Search Console (optional but recommended) ----
# Get from https://search.google.com/search-console → HTML tag method → content value
# Example: GOOGLE_SITE_VERIFICATION=abc123...  (also you can drop file into /public/google*.html)
GOOGLE_SITE_VERIFICATION=

# ---- AdMob (optional — test IDs are built-in) ----
# سيبهم فاضيين وانت بتجرب: التطبيق هيستخدم إعلانات Google التجريبية تلقائياً.
# قبل الرفع النهائي على Play حط الـ IDs الحقيقية من https://apps.admob.com
# NEXT_PUBLIC_ADMOB_BANNER=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
# NEXT_PUBLIC_ADMOB_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
# ملحوظة: الـ App ID (اللي شكله ~XXXXXXXXXX) بيتحط يدوي في AndroidManifest/Info.plist
# عبر: node scripts/setup-admob.js --app-id=ca-app-pub-XXX~YYY

# ---- CORS allow-list (comma-separated). The APK + localhost are built-in. ----
# Example: ALLOWED_ORIGINS=https://atlasfit.pro,https://www.atlasfit.pro
ALLOWED_ORIGINS=
# APP_URL=https://your-app.vercel.app
